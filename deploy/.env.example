# Bearer 鉴权密钥（必填），VoStory TTS 提供商的「API 密钥」填同一个值
API_KEY=change-me

# 模型：Hugging Face 仓库名与版本；首次启动自动下载到 ./hf-cache
MODEL_ID=BreezeBlue/Breeze-TTS-2
MODEL_REVISION=
# 模型页需要同意许可时填写 Hugging Face 访问令牌
HF_TOKEN=

# 全部加速路径（CUDA Graph），约需 14.4GB 显存；显存不足 16GB 时设为 false
FAST_ALL=true

# 宿主机端口
HOST_PORT=7860

# 使用的镜像（本地构建时作为构建产物的镜像名）
BREEZE_IMAGE=han3sui/breeze-tts:latest

# 本地构建参数
FLASH_ATTN_CUDA_ARCHS=80;90
MAX_JOBS=4
