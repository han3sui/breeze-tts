# Bearer 鉴权（必填），VoStory「API 密钥」填同一个值
API_KEY=

# 必须放数据盘，系统盘约 30GB 装不下模型
HF_HOME=/root/autodl-tmp/hf-cache

# AutoDL 自定义服务只映射 6006 / 6008
HOST=0.0.0.0
PORT=6006

MODEL_ID=BreezeBlue/Breeze-TTS-2
MODEL_REVISION=
HF_TOKEN=

# 约需 14.4GB 显存；16GB 及以下设为 false
FAST_ALL=true

# 国内拉权重；不用镜像则留空
HF_ENDPOINT=https://hf-mirror.com
