# Bearer 鉴权（公网必填），VoStory「API 密钥」填同一个值
API_KEY=

# 模型缓存目录；安装脚本会写成绝对路径
HF_HOME=

# 本机监听；只本机访问可改成 127.0.0.1
HOST=0.0.0.0
PORT=7860

MODEL_ID=BreezeBlue/Breeze-TTS-2
MODEL_REVISION=
# 已有本地下载的权重目录时填写，优先于 MODEL_ID
MODEL_PATH=
HF_TOKEN=

# Intel XPU 没有 CUDA Graph，必须保持 false
FAST_ALL=false
DEVICE=xpu
# A770 出杂音或 NaN 时改成 float16
DTYPE=bfloat16

# 国内拉权重；不用镜像则留空
HF_ENDPOINT=https://hf-mirror.com

# 安装脚本会写入 .venv-intel 的 python 绝对路径
PYTHON=

# 进程被 XPU 断言杀掉后是否自动拉起（false 可停一次看现场）
RESTART_ON_CRASH=true
RESTART_DELAY_SEC=5
RESTART_MAX_DELAY_SEC=60
# 连续运行超过该秒数再崩，退避计数清零
RESTART_HEALTHY_SEC=120
