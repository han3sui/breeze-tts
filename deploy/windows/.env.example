# Bearer 鉴权（公网必填），VoStory「API 密钥」填同一个值
API_KEY=

# 模型缓存目录；安装脚本会写成绝对路径
HF_HOME=

# 本机监听；只本机访问可改成 127.0.0.1
HOST=0.0.0.0
PORT=7860

MODEL_ID=BreezeBlue/Breeze-TTS-2
MODEL_REVISION=
# 已有本地下载的权重目录时填写，优先于 MODEL_ID
MODEL_PATH=
HF_TOKEN=

# 约需 14.4GB 显存；16GB 及以下设为 false。Windows 上仍走 CUDA Graph，不编 flash-attn
FAST_ALL=true

# 国内拉权重；不用镜像则留空
HF_ENDPOINT=https://hf-mirror.com

# 安装脚本会写入当前 python 绝对路径
PYTHON=

# 关掉 dynamo，避免 torch 2.9.1 inductor 预热报错；CUDA Graph 仍可用
TORCHDYNAMO_DISABLE=1
